{
  "name": "astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "sync-images": "node scripts/sync-images.mjs",
    "dev": "node scripts/sync-images.mjs && astro dev",
    "build": "node scripts/sync-images.mjs && astro build && cp dist/blog.bokken.io/sitemap-index.xml dist/blog.bokken.io/sitemap.xml && node scripts/prepare-worker-assets.mjs",
    "smoke:worker": "node scripts/smoke-worker.mjs",
    "test:workers": "node --test workers/*.test.mjs",
    "verify:worker-assets": "node scripts/verify-worker-assets.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.5",
    "prettier": "^3.9.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  }
}
